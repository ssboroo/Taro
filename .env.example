# Server-only Wire payment gateway; customer-facing label is QPay.
WIRE_MN_API_KEY=
# Exact ID of the enabled QPay operator on the gateway dashboard.
WIRE_QPAY_OPERATOR_ID=
# Optional: polling works without webhook. Use a NEW endpoint secret for this site.
WIRE_MN_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://rainy-tarot.ssboroostore.chatgpt.site
# Railway: mount a persistent volume at /data and set this path.
PAYMENT_DB_PATH=/data/payments.sqlite
